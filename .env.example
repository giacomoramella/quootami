# ============================================================
# Quootami — Variabili d'ambiente
# ============================================================
# Copia questo file in `.env.local` per sviluppo locale.
# Su Vercel imposta queste variabili in Settings → Environment Variables.
# Mai committare `.env.local` (è già in .gitignore).
# ============================================================

# ── Public Base URL (per webhook callback) ──
PUBLIC_BASE_URL=https://quootami.it

# ── Supabase (database + storage) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SOLO server, mai esposta al client

# ── Resend (email transazionali) ──
RESEND_API_KEY=
INTERMEDIARIO_EMAIL=giacomo.rp@sistoassicurazioni.com

# ── Provider FEA (firma elettronica avanzata) ──
FEA_BASE_URL=
FEA_API_KEY=
FEA_WEBHOOK_SECRET=
